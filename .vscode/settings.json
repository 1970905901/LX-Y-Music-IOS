{
  "i18n-ally.localesPaths": [
    "src/lang"
  ],
  // "i18n-ally.fullReloadOnChanged": true,
  "i18n-ally.keystyle": "nested",
  "i18n-ally.displayLanguage": "zh-cn",
  "i18n-ally.sourceLanguage": "zh-cn",
  "i18n-ally.translate.engines": [
    "google-cn",
    "google"
  ],
  "i18n-ally.sortKeys": true,
  // 指向仓库自身的 TypeScript（package.json devDependencies: typescript@5.9.3）。
  // 原值 "packages/shared/eslint/node_modules/typescript/lib" 指向上游 lx-music-desktop
  // 单仓（monorepo）的路径，本仓库没有 packages/ 目录 —— VS Code 找不到该版本后会
  // 回退到内置 TS，类型提示与实际编译版本不一致。
  "typescript.tsdk": "node_modules/typescript/lib"
}
