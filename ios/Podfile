# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '14.0'
prepare_react_native_project!

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```
flipper_config = ENV['NO_FLIPPER'] == "1" ? FlipperConfiguration.disabled : FlipperConfiguration.enabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

def lx_build_libflac_xcframework
  script = File.join(__dir__, 'Vendor', 'LXLibFLAC', 'build_xcframework.sh')
  Pod::UI.puts 'Building LXLibFLAC xcframework...'.green
  success = system('bash', script)
  raise 'Failed to build LXLibFLAC xcframework' unless success
end

def lx_patch_swift_audio_seek(installer)
  wrapper_path = Dir.glob(File.join(installer.sandbox.root.to_s, '**', 'AVPlayerWrapper.swift'))
    .find { |file| file.include?('SwiftAudioEx') || file.include?('SwiftAudio') }

  unless wrapper_path
    Pod::UI.puts 'Skip SwiftAudio seek patch: AVPlayerWrapper.swift not found'.yellow
    return
  end

  replacement = <<~'SWIFT'
    func seek(to seconds: TimeInterval) {
        // if the player is loading then we need to defer seeking until it's ready.
        if (avPlayer.currentItem == nil) {
            timeToSeekToAfterLoading = seconds
        } else {
            let time = CMTimeMakeWithSeconds(seconds, preferredTimescale: CMTimeScale(NSEC_PER_SEC))
            let performSeek = { [weak self] (completion: @escaping (Bool) -> Void) in
                guard let self = self else {
                    completion(false)
                    return
                }
                self.currentItem?.cancelPendingSeeks()
                self.avPlayer.seek(to: time, toleranceBefore: CMTime.zero, toleranceAfter: CMTime.zero, completionHandler: completion)
            }

            performSeek { [weak self] finished in
                guard let self = self else { return }
                let currentTime = self.avPlayer.currentTime().seconds
                if finished && !currentTime.isNaN && abs(currentTime - seconds) > 0.2 {
                    performSeek { [weak self] retryFinished in
                        guard let self = self else { return }
                        self.delegate?.AVWrapper(seekTo: Double(seconds), didFinish: retryFinished)
                    }
                    return
                }
                self.delegate?.AVWrapper(seekTo: Double(seconds), didFinish: finished)
            }
        }
    }

    func seek(by seconds: TimeInterval) {
  SWIFT

  source = File.binread(wrapper_path)
  return if source.include?(replacement.strip)

  patched = source.gsub(/func seek\(to seconds: TimeInterval\) \{.*?func seek\(by seconds: TimeInterval\) \{/m, replacement)
  if patched == source
    Pod::UI.puts "Skip SwiftAudio seek patch: pattern not found in #{wrapper_path}".yellow
    return
  end

  File.binwrite(wrapper_path, patched)
  Pod::UI.puts "Patched SwiftAudio seek: #{wrapper_path}".green
end

def lx_patch_swift_audio_player_access(installer)
  queued_player_path = Dir.glob(File.join(installer.sandbox.root.to_s, '**', 'QueuedAudioPlayer.swift'))
    .find { |file| file.include?('SwiftAudioEx') || file.include?('SwiftAudio') }

  unless queued_player_path
    Pod::UI.puts 'Skip SwiftAudio queued player patch: QueuedAudioPlayer.swift not found'.yellow
    return
  end

  source = File.binread(queued_player_path)
  source = source.sub("import Foundation\nimport MediaPlayer", "import Foundation\nimport AVFoundation\nimport MediaPlayer") unless source.include?("import AVFoundation")

  insertion = <<~'SWIFT'.strip
    public var currentPlayerItem: AVPlayerItem? {
        return wrapper.currentItem
    }
  SWIFT

  return if source.include?(insertion.strip)

  patched = source.sub(/public var currentIndex: Int \{\s*(?:return )?[A-Za-z_][A-Za-z0-9_]*\.currentIndex\s*\}/m) do |match|
    "#{match}\n\n#{insertion.strip}"
  end
  if patched == source
    Pod::UI.puts "Skip SwiftAudio queued player patch: anchor not found in #{queued_player_path}".yellow
    return
  end

  File.binwrite(queued_player_path, patched)
  Pod::UI.puts "Patched SwiftAudio queued player access: #{queued_player_path}".green
end

target 'LxMusicMobile' do
  config = use_native_modules!

  lx_build_libflac_xcframework
  pod 'LXLibFLAC', :path => './Vendor/LXLibFLAC'

  # CocoaPods trunk CDN (jsdelivr) intermittently returns 400 for this spec; pin via vendored podspec.
  pod 'SwiftAudioEx', :podspec => './Vendor/SwiftAudioEx.podspec.json'

  # 液态玻璃背景（迷你播放器 / 底部 Tab）：vendored 自 DnV1eX/LiquidGlassKit。
  # 上游仅支持 SPM（swift-tools 6.2 需 Xcode 26，CI 的 Xcode 15.4 无法解析），
  # 已本地 pod 化并做 Swift 5.10 / iOS 17.5 SDK 兼容改造，见 Vendor/LiquidGlassKit/LICENSE-NOTES.md。
  pod 'LiquidGlassKit', :path => './Vendor/LiquidGlassKit'

  use_react_native!(
    :path => config[:reactNativePath],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LxMusicMobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    lx_patch_swift_audio_seek(installer)
    lx_patch_swift_audio_player_access(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      end
    end

    # 让主工程（AppDelegate.mm）能找到 vendored 的 FLAC 头文件，从而 __has_include(<FLAC/stream_decoder.h>)
    # 命中、LX_HAS_LIBFLAC 被定义为 1，FLAC 解码链路才会真正编译进二进制。否则 LX_HAS_LIBFLAC 为 0，
    # StreamingFlacPlayerModule 失去解码能力，FLAC/Hi-Res 播放静音。
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_targets.each do |target|
        next unless target.name == 'LxMusicMobile'
        target.build_configurations.each do |config|
          hsp = config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
          hsp = [hsp] unless hsp.is_a?(Array)
          vendor_inc = '"$(SRCROOT)/Vendor/LXLibFLAC/include"'
          unless hsp.any? { |p| p.to_s.include?('LXLibFLAC/include') }
            hsp << vendor_inc
          end
          config.build_settings['HEADER_SEARCH_PATHS'] = hsp

          # Xcode 26：Swift pods 以 Swift 5 模式编译到低部署目标时会自动链接
          # swiftCompatibility56/Concurrency/Packs 兼容库，但 RN 0.73 的 app 配置
          # 未把 Swift 工具链库目录放进库搜索路径，链接期 autolink 解析不到
          # （Undefined symbols __swift_FORCE_LOAD_$_swiftCompatibility56）。
          lsp = config.build_settings['LIBRARY_SEARCH_PATHS'] || '$(inherited)'
          lsp = [lsp] unless lsp.is_a?(Array)
          unless lsp.any? { |p| p.to_s.include?('usr/lib/swift') }
            lsp << '"$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"'
          end
          config.build_settings['LIBRARY_SEARCH_PATHS'] = lsp
        end
      end
    end
    # Xcode 26：Swift pods 以 Swift 5 模式编译到低部署目标时自动链接 swiftCompatibility*
    # 兼容库，RN 0.73 的链接配置没有 Swift 工具链库目录，autolink 解析不到
    # （Undefined symbols __swift_FORCE_LOAD_$_swiftCompatibility*）。直接把搜索路径
    # 追加到生成的 app xcconfig 末尾（最后一条赋值生效，$(inherited) 保留原值）。
    pod_xcconfig_dir = File.join(__dir__, 'Pods/Target Support Files/Pods-LxMusicMobile')
    %w(
      Pods-LxMusicMobile.xcconfig
      Pods-LxMusicMobile.debug.xcconfig
      Pods-LxMusicMobile.release.xcconfig
    ).each do |name|
      path = File.join(pod_xcconfig_dir, name)
      next unless File.exist?(path)
      content = File.read(path)
      addition = 'LIBRARY_SEARCH_PATHS = $(inherited) "$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"'
      unless content.include?('usr/lib/swift/$(PLATFORM_NAME)')
        File.write(path, content.rstrip + "\n" + addition + "\n")
      end
    end
  end
end
